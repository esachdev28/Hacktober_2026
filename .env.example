# CHAOSPATCH Backend Environment
# Copy to .env and fill in values

# Hugging Face Inference
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/v1
HF_PROVIDER=featherless-ai

# Application
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite:///./chaospatch.db
CORS_ORIGINS=http://localhost:5173

# Experiment Limits
MAX_REPAIR_ATTEMPTS=3
EXPERIMENT_TIMEOUT_SECONDS=300
MAX_PATCH_SIZE_BYTES=10000
MAX_CHANGED_FILES=5
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=4096
