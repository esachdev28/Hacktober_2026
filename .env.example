# CHAOSPATCH Backend Environment — Strict Single-Model Architecture
# Copy to .env and set your NVIDIA_API_KEY. Never commit .env to Git.

# ─────────────────────────────────────────────────────────────────────
# SOLE AI INFERENCE PROVIDER: NVIDIA NIM (z-ai/glm-5.3-flash)
# Get an API key at https://build.nvidia.com
# ─────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite:///./chaospatch.db
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# Experiment Limits
# ─────────────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
EXPERIMENT_TIMEOUT_SECONDS=300
MAX_PATCH_SIZE_BYTES=10000
MAX_CHANGED_FILES=5
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=2048
