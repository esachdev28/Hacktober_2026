# CHAOSPATCH Backend Environment
# Copy to .env and fill in your values. Never commit .env to Git.

# ─────────────────────────────────────────────────────────────────────
# AI INFERENCE — Option A: NVIDIA NIM (recommended)
# Get a free API key at https://build.nvidia.com
# ─────────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────────────────────────────
# AI INFERENCE — Option B: Hugging Face Router
# Token must start with hf_ — get one at https://huggingface.co/settings/tokens
# ─────────────────────────────────────────────────────────────────────
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/v1
HF_PROVIDER=featherless-ai

# Provider selection: "auto" | "nvidia" | "huggingface"
# "auto" prefers NVIDIA_API_KEY if set, else falls back to HF_TOKEN.
INFERENCE_PROVIDER=auto

# ─────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite:///./chaospatch.db
CORS_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# Experiment Limits
# ─────────────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
EXPERIMENT_TIMEOUT_SECONDS=300
MAX_PATCH_SIZE_BYTES=10000
MAX_CHANGED_FILES=5
MODEL_TEMPERATURE=0.3
# MiniMax M3.1-Flash is a reasoning model; 2048 includes its thinking budget.
MODEL_MAX_TOKENS=2048
